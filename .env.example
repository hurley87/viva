# Convex (from `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Privy — same app ID in public and server vars. Never commit secrets.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Also set PRIVY_APP_ID on the Convex deployment:
#   npx convex env set PRIVY_APP_ID "<your-app-id>"

# OpenAI — Realtime Examiner + Grader. Set on the Convex deployment, not only Next:
#   npx convex env set OPENAI_API_KEY "<sk-...>"
# Optional. Default is gpt-5.6-sol (pinned 2026-08-27 against the current lineup).
#   npx convex env set GRADER_MODEL "gpt-5.6-sol"
